# ===================================================================
# THINK IT - MEETING MEMORY AI PLATFORM ENVIRONMENT CONFIGURATION
# ===================================================================

# -------------------------------------------------------------------
# Database Configuration (PostgreSQL + Prisma)
# -------------------------------------------------------------------
DATABASE_URL="postgresql://neondb_owner:password@ep-long-cloud-axzx661m-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"

# -------------------------------------------------------------------
# Groq Cloud API Integration (High-Speed Llama 3.3 70B & Inference)
# -------------------------------------------------------------------
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# -------------------------------------------------------------------
# NVIDIA NIM & Riva Cloud API Integration (Microservices & Translation)
# -------------------------------------------------------------------
NVIDIA_NIM_API_KEY=YOUR_NVIDIA_NIM_API_KEY
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_RIVA_API_KEY=YOUR_NVIDIA_RIVA_API_KEY
NVIDIA_RIVA_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_NEMOTRON_API_KEY=YOUR_NVIDIA_NEMOTRON_API_KEY
NVIDIA_NEMOTRON_ENDPOINT=https://integrate.api.nvidia.com/v1

# -------------------------------------------------------------------
# AI Provider Fallbacks (Gemini, Kimi, Meta Llama Vision)
# -------------------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
KIMI_API_KEY=YOUR_KIMI_API_KEY
KIMI_BASE_URL=https://integrate.api.nvidia.com/v1
LLAMA_API_KEY=YOUR_LLAMA_API_KEY
LLAMA_ENDPOINT=https://integrate.api.nvidia.com/v1
AI_TIMEOUT=30000
AI_MAX_RETRIES=3
PROMPT_VERSION=1.2.0

# -------------------------------------------------------------------
# Microsoft Entra ID & Microsoft Graph API Integration
# -------------------------------------------------------------------
AZURE_TENANT_ID=YOUR_AZURE_TENANT_ID
AZURE_CLIENT_ID=YOUR_AZURE_CLIENT_ID
AZURE_CLIENT_SECRET=YOUR_AZURE_CLIENT_SECRET
MICROSOFT_GRAPH_TENANT_ID=YOUR_MICROSOFT_GRAPH_TENANT_ID
MICROSOFT_GRAPH_CLIENT_ID=YOUR_MICROSOFT_GRAPH_CLIENT_ID
MICROSOFT_GRAPH_CLIENT_SECRET=YOUR_MICROSOFT_GRAPH_CLIENT_SECRET
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_SCOPES="User.Read Calendars.Read OnlineMeetings.Read OnlineMeetingTranscript.Read.All Team.ReadBasic.All"

# -------------------------------------------------------------------
# Microsoft Teams Application & Bot Configuration
# -------------------------------------------------------------------
TEAMS_APP_ID=8ec8a471-4328-4e8f-8c69-e64abdf2725
TEAMS_BOT_ID=8ec8a471-4328-4e8f-8c69-e64abdf2725
