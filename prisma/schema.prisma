generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String   @default("Developer")
  avatar    String?
  active    Boolean  @default(true)
  presence  String   @default("Available")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id               String   @id @default(uuid())
  name             String
  key              String   @unique
  description      String?
  lead             String?
  userStoriesCount Int      @default(0)
  bugsCount        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model JiraConnection {
  id               String   @id @default(uuid())
  baseUrl          String
  email            String
  apiToken         String
  selectedProjects String[]
  createdAt        DateTime @default(now())
}

model TeamsConnection {
  id           String   @id @default(uuid())
  tenantId     String
  clientId     String
  clientSecret String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Meeting {
  id               String   @id @default(uuid())
  title            String
  subject          String
  projectName      String?
  organizer        String
  date             DateTime
  status           String   @default("COMPLETED")
  durationMinutes  Int      @default(30)
  summary          String?
  executiveSummary String?
  detailedSummary  String?
  mom              String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizer])
  @@index([status])
}

model AIJob {
  id         String   @id @default(uuid())
  meetingId  String
  status     String   @default("QUEUED")
  priority   String   @default("NORMAL")
  retryCount Int      @default(0)
  maxRetries Int      @default(3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([meetingId])
  @@index([status])
}

model KnowledgeDocument {
  id               String   @id @default(uuid())
  meetingId        String
  title            String
  executiveSummary String?
  detailedSummary  String?
  indexedAt        DateTime @default(now())

  @@index([meetingId])
}

model NotificationPreference {
  userId                 String   @id
  enableMeetingSummaries Boolean  @default(true)
  enableActionReminders  Boolean  @default(true)
  enableDecisionAlerts   Boolean  @default(true)
  enableRiskAlerts       Boolean  @default(true)
  deliveryChannel        String   @default("TEAMS_BOT")
  updatedAt              DateTime @updatedAt
}

model CustomMeetingReport {
  id               String   @id @default(uuid())
  meetingName      String
  uploadDate       DateTime @default(now())
  processingDate   DateTime @default(now())
  aiProviderUsed   String   @default("AIGateway Router")
  processingTimeMs Int      @default(1200)
  status           String   @default("COMPLETED")
  fileTypes        String[]
  keywords         String[]
  tags             String[]
  summary          String?
  mom              String?
  actionItems      Json?
  decisions        Json?
  risks            Json?
  timeline         Json?
  recommendations  Json?
  createdAt        DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model MeetingTranscript {
  id                 String   @id @default(uuid())
  meetingId          String
  speakerId          String
  speakerName        String
  startTime          String
  endTime            String
  audioOffsetMs      Int      @default(0)
  processingDuration Int      @default(150)
  originalLanguage   String
  languageCode       String
  originalTranscript String
  englishTranscript  String
  asrModelUsed       String
  translationModel   String
  translationScore   Float    @default(0.98)
  status             String   @default("PROCESSED")
  createdAt          DateTime @default(now())

  @@index([meetingId])
  @@index([speakerId])
}

// =========================================================================================
// TEAMS MEETING RECORD — PERSISTENT LIFECYCLE STATE MACHINE MODEL
// =========================================================================================
// Represents real Microsoft Teams meeting records discovered via Microsoft Graph Calendar Change
// Notifications (/users/{userId}/events).
//
// Lifecycle Status Transitions:
// -----------------------------
// DISCOVERED -> SCHEDULED -> CONSENT_PENDING -> CONSENT_GRANTED (or DECLINED) -> JOIN_REQUESTED
// -> JOINED -> ACTIVE -> ENDED -> TRANSCRIPT_PENDING -> TRANSCRIPT_RECEIVED -> AI_PROCESSING -> COMPLETED
//
// Unique Constraint:
// ------------------
// @@unique([tenantId, calendarEventId]) prevents duplicate meeting creation from redundant Graph webhooks.
model TeamsMeetingRecord {
  id               String    @id @default(uuid())
  tenantId         String    // Microsoft Entra Tenant ID
  organizerId      String?   // Microsoft Graph User ID of Meeting Organizer
  organizerEmail   String    // Email Address of Meeting Organizer
  calendarEventId  String    // Microsoft Graph Outlook Calendar Event Identifier
  onlineMeetingId  String?   // Microsoft Graph Teams Online Meeting Identifier
  joinWebUrl       String?   // Microsoft Teams Meeting Join Web URL
  subject          String    // Scheduled Meeting Subject / Title
  scheduledStart   DateTime? // Scheduled Start Timestamp
  scheduledEnd     DateTime? // Scheduled End Timestamp
  actualStart      DateTime? // Actual Call Established Timestamp
  actualEnd        DateTime? // Actual Call Concluded Timestamp
  lifecycleStatus  String    @default("DISCOVERED") // State Machine Status
  consentStatus    String    @default("PENDING")    // PENDING | APPROVED | DECLINED
  transcriptStatus String    @default("PENDING")    // PENDING | RETRIEVED | FAILED
  aiStatus         String    @default("QUEUED")     // QUEUED | PROCESSING | COMPLETED | FAILED
  transcriptId     String?   // Microsoft Graph Transcript Identifier
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, calendarEventId])
  @@index([tenantId])
  @@index([lifecycleStatus])
}


