{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.15/MicrosoftTeams.schema.json",
  "manifestVersion": "1.15",
  "version": "1.0.0",
  "id": "8ec8a471-4328-4e8f-8c69-e64abdf2725",
  "packageName": "com.thinkpalm.thinkit.teamsapp",
  "developer": {
    "name": "ThinkPalm Technologies",
    "websiteUrl": "https://thinkpalm.com",
    "privacyUrl": "https://thinkpalm.com/privacy",
    "termsOfUseUrl": "https://thinkpalm.com/terms"
  },
  "name": {
    "short": "ThinkItAIMeetingAssistant",
    "full": "ThinkItAIMeetingAssistant - AI Meeting Intelligence & Enterprise Memory"
  },
  "description": {
    "short": "AI Meeting Assistant for Microsoft Teams",
    "full": "ThinkItAIMeetingAssistant automatically captures Microsoft Teams meetings, synthesizes executive summaries, formal MOMs, action items, decisions, and regional dialogue translations using Meta Llama 3.3 70B & NVIDIA Riva."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#4F46E5",
  "staticTabs": [
    {
      "entityId": "collection",
      "name": "Collection",
      "contentUrl": "https://project-plugin.vercel.app/#/collection?inTeams=true",
      "scopes": [
        "personal"
      ]
    },
    {
      "entityId": "settings",
      "name": "Settings",
      "contentUrl": "https://project-plugin.vercel.app/#/settings?inTeams=true",
      "scopes": [
        "personal"
      ]
    },
    {
      "entityId": "customReport",
      "name": "Custom Report",
      "contentUrl": "https://project-plugin.vercel.app/#/custom-report?inTeams=true",
      "scopes": [
        "personal"
      ]
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "localhost",
    "127.0.0.1",
    "project-plugin.vercel.app",
    "projectplugin-api.onrender.com",
    "*.thinkpalm.com"
  ],
  "webApplicationInfo": {
    "id": "8ec8a471-4328-4e8f-8c69-e64abdf2725",
    "resource": "api://project-plugin.vercel.app/8ec8a471-4328-4e8f-8c69-e64abdf2725"
  },
  "bots": [
    {
      "botId": "8ec8a471-4328-4e8f-8c69-e64abdf2725",
      "scopes": [
        "personal",
        "team",
        "groupchat"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "name": "OnlineMeetingTranscript.Read.Group",
          "type": "Delegated"
        }
      ]
    }
  }
}